# crawler/.env.local — 실제 값을 채운 뒤 이 파일명을 .env.local로 저장하세요.
# 이 파일(.env.local)은 .gitignore에 등록되어 있어 git에 커밋되지 않습니다.
# env_local.py가 main.py 시작 시 이 파일을 읽어 os.environ에 주입합니다.

# ko 번역(Phase A)을 클라우드로 돌릴 때 사용. 없으면 로컬 LLM으로 자동 대체됨.
# 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 다이제스트 메일 발신 계정 (지메일)
# 앱 비밀번호 발급: 구글 계정 → 보안 → 2단계 인증 → 앱 비밀번호
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# 다이제스트 메일 수신자 (비워두면 GMAIL_ADDRESS 자기 자신에게 발송)
DIGEST_RECIPIENT=sy1122.lee@samsung.com
